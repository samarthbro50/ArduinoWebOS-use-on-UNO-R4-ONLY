#include <WiFiS3.h>
#include <stdlib.h>

// ArduinoOS for Arduino UNO R4 WiFi
// Connect to the access point, then open http://192.168.4.1
const char* WIFI_NAME = "Arduino WebOS";
const char* WIFI_PASSWORD = "asdfg12345"; // Change this to your own 8+ character password.
WiFiServer server(80);
bool serverStarted = false;

String tasks[5] = {"Workout", "Water", "Read", "", ""};
bool taskDone[5] = {false, false, false, false, false};
int taskCount = 3;

// Small RAM-only family chat: the latest 10 messages are kept until reset/power-off.
const int MAX_MESSAGES = 10;
String messageNames[MAX_MESSAGES];
String messageTexts[MAX_MESSAGES];
unsigned long messageTimes[MAX_MESSAGES];
int messageCount = 0;

// Tiny LAN arena state: up to four browser players, stored in RAM only.
struct ArenaPlayer { bool active; String name; float x; float y; int hp; int cash; int gun; unsigned long seen; };
ArenaPlayer arenaPlayers[4] = {
  {false, "", 70, 70, 100, 300, 0, 0},
  {false, "", 650, 70, 100, 300, 0, 0},
  {false, "", 70, 300, 100, 300, 0, 0},
  {false, "", 650, 300, 100, 300, 0, 0}
};

String urlDecode(const String& input) {
  String out;
  out.reserve(input.length());
  for (unsigned int i = 0; i < input.length(); i++) {
    char c = input[i];
    if (c == '+') out += ' ';
    else if (c == '%' && i + 2 < input.length()) {
      char hex[3] = {input[i + 1], input[i + 2], '\0'};
      out += (char)strtol(hex, NULL, 16);
      i += 2;
    } else out += c;
  }
  return out;
}

String getParameter(const String& path, const String& key) {
  String search = key + "=";
  int pos = path.indexOf(search);
  if (pos < 0) return "";
  pos += search.length();
  int end = path.indexOf('&', pos);
  if (end < 0) end = path.length();
  return urlDecode(path.substring(pos, end));
}

String htmlEscape(const String& input) {
  String out;
  for (unsigned int i = 0; i < input.length(); i++) {
    char c = input[i];
    if (c == '&') out += F("&amp;");
    else if (c == '<') out += F("&lt;");
    else if (c == '>') out += F("&gt;");
    else if (c == '"') out += F("&quot;");
    else if (c == '\'') out += F("&#39;");
    else out += c;
  }
  return out;
}

String jsonEscape(const String& input) {
  String out;
  for (unsigned int i = 0; i < input.length(); i++) {
    char c = input[i];
    if (c == '"' || c == '\\') { out += '\\'; out += c; }
    else if (c == '\n') out += F("\\n");
    else if (c == '\r') out += F("\\r");
    else if ((uint8_t)c >= 32) out += c;
  }
  return out;
}

void sendHeader(WiFiClient& client, const char* contentType) {
  client.print(F("HTTP/1.1 200 OK\r\nContent-Type: "));
  client.print(contentType);
  client.print(F("\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n"));
}

void redirectClient(WiFiClient& client, const char* destination) {
  client.print(F("HTTP/1.1 303 See Other\r\nLocation: "));
  client.print(destination);
  client.print(F("\r\nConnection: close\r\n\r\n"));
  client.stop();
}

void sendMessagesJson(WiFiClient& client) {
  sendHeader(client, "application/json; charset=utf-8");
  client.print('[');
  for (int i = 0; i < messageCount; i++) {
    if (i) client.print(',');
    client.print(F("{\"name\":\"")); client.print(jsonEscape(messageNames[i]));
    client.print(F("\",\"text\":\"")); client.print(jsonEscape(messageTexts[i]));
    client.print(F("\",\"time\":\""));
    unsigned long seconds = messageTimes[i] / 1000;
    client.print(seconds); client.print(F("s ago\"}"));
  }
  client.print(']');
}

void sendArenaState(WiFiClient& client) {
  unsigned long now = millis();
  for (int i = 0; i < 4; i++) if (arenaPlayers[i].active && now - arenaPlayers[i].seen > 15000UL) arenaPlayers[i].active = false;
  sendHeader(client, "application/json; charset=utf-8");
  client.print('[');
  bool first = true;
  for (int i = 0; i < 4; i++) {
    if (!arenaPlayers[i].active) continue;
    if (!first) client.print(','); first = false;
    client.print('{');
    client.print(F("\"id\":")); client.print(i);
    client.print(F(",\"name\":\"")); client.print(jsonEscape(arenaPlayers[i].name)); client.print(F("\""));
    client.print(F(",\"x\":")); client.print(arenaPlayers[i].x, 1);
    client.print(F(",\"y\":")); client.print(arenaPlayers[i].y, 1);
    client.print(F(",\"hp\":")); client.print(arenaPlayers[i].hp);
    client.print(F(",\"cash\":")); client.print(arenaPlayers[i].cash);
    client.print(F(",\"gun\":")); client.print(arenaPlayers[i].gun);
    client.print('}');
  }
  client.print(']');
}

void handleArena(WiFiClient& client, const String& path) {
  String act = getParameter(path, "act");
  int id = getParameter(path, "id").toInt();
  unsigned long now = millis();
  for (int i = 0; i < 4; i++) if (arenaPlayers[i].active && now - arenaPlayers[i].seen > 15000UL) arenaPlayers[i].active = false;
  if (act == "join") {
    if (id >= 0 && id < 4 && arenaPlayers[id].active) { arenaPlayers[id].seen = now; }
    else {
      id = -1;
      for (int i = 0; i < 4; i++) if (!arenaPlayers[i].active) { id = i; break; }
      if (id >= 0) {
        arenaPlayers[id].active = true;
        arenaPlayers[id].name = getParameter(path, "name");
        arenaPlayers[id].name.trim(); if (!arenaPlayers[id].name.length()) arenaPlayers[id].name = "Player" + String(id + 1);
        if (arenaPlayers[id].name.length() > 12) arenaPlayers[id].name = arenaPlayers[id].name.substring(0, 12);
        arenaPlayers[id].x = (id % 2) ? 650 : 70; arenaPlayers[id].y = (id < 2) ? 70 : 300;
        arenaPlayers[id].hp = 100; arenaPlayers[id].cash = 300; arenaPlayers[id].gun = 0;
      }
    }
    sendHeader(client, "application/json; charset=utf-8");
    client.print(F("{\"id\":")); client.print(id); client.print(F(",\"ok\":")); client.print(id >= 0 ? F("true") : F("false")); client.print('}');
    return;
  }
  if (act == "leave") {
    if (id >= 0 && id < 4) arenaPlayers[id].active = false;
    sendHeader(client, "text/plain; charset=utf-8"); client.print(F("OK")); return;
  }
  if (act == "move" && id >= 0 && id < 4 && arenaPlayers[id].active) {
    arenaPlayers[id].x = constrain(getParameter(path, "x").toFloat(), 12, 708);
    arenaPlayers[id].y = constrain(getParameter(path, "y").toFloat(), 12, 388);
    arenaPlayers[id].hp = constrain(getParameter(path, "hp").toInt(), 0, 100);
    arenaPlayers[id].cash = constrain(getParameter(path, "cash").toInt(), 0, 999999);
    arenaPlayers[id].gun = constrain(getParameter(path, "gun").toInt(), 0, 4);
    arenaPlayers[id].seen = now;
    sendArenaState(client); return;
  }
  if (act == "hit" && id >= 0 && id < 4 && arenaPlayers[id].active) {
    int target = getParameter(path, "target").toInt();
    int damage = constrain(getParameter(path, "dmg").toInt(), 1, 100);
    bool hit = target >= 0 && target < 4 && target != id && arenaPlayers[target].active && arenaPlayers[target].hp > 0;
    bool eliminated = false;
    if (hit) { arenaPlayers[target].hp = max(0, arenaPlayers[target].hp - damage); arenaPlayers[id].seen = now; arenaPlayers[target].seen = now; eliminated = arenaPlayers[target].hp == 0; }
    sendHeader(client, "application/json; charset=utf-8");
    client.print(F("{\"hit\":")); client.print(hit ? F("true") : F("false"));
    client.print(F(",\"eliminated\":")); client.print(eliminated ? F("true") : F("false"));
    client.print(F(",\"hp\":")); client.print(hit ? arenaPlayers[target].hp : 0); client.print('}'); return;
  }
  if (act == "state") { sendArenaState(client); return; }
  sendHeader(client, "application/json; charset=utf-8"); client.print(F("{\"ok\":false}"));
}

void setup() {
  Serial.begin(115200);
  // Start the UNO R4 WiFi access point as soon as setup begins.
  int status = WiFi.beginAP(WIFI_NAME, WIFI_PASSWORD);
  for (int attempt = 0; attempt < 4 && status != WL_AP_LISTENING && status != WL_AP_CONNECTED; attempt++) {
    delay(250);
    status = WiFi.beginAP(WIFI_NAME, WIFI_PASSWORD);
  }
  if (status == WL_AP_LISTENING || status == WL_AP_CONNECTED) {
    server.begin();
    serverStarted = true;
    Serial.println(F("ArduinoOS is online."));
    Serial.print(F("Wi-Fi: ")); Serial.println(WIFI_NAME);
    Serial.println(F("Open http://192.168.4.1"));
  } else {
    Serial.print(F("Wi-Fi AP failed, status: ")); Serial.println(status);
  }
}

void loop() {
  if (!serverStarted) return;
  WiFiClient client = server.available();
  if (!client) return;
  client.setTimeout(1000);
  String requestLine = client.readStringUntil('\n');
  requestLine.trim();
  unsigned long started = millis();
  while (client.connected() && millis() - started < 200) {
    if (client.available()) { if (client.read() == '\n') break; }
    else delay(1);
  }
  int firstSpace = requestLine.indexOf(' ');
  int secondSpace = requestLine.indexOf(' ', firstSpace + 1);
  if (firstSpace < 0 || secondSpace < 0) { client.stop(); return; }
  String method = requestLine.substring(0, firstSpace);
  String path = requestLine.substring(firstSpace + 1, secondSpace);
  if (method != "GET") {
    client.print(F("HTTP/1.1 405 Method Not Allowed\r\nConnection: close\r\n\r\n"));
    client.stop(); return;
  }

  if (path.startsWith("/arena?")) { handleArena(client, path); client.stop(); return; }
  if (path == "/messages") { sendMessagesJson(client); client.stop(); return; }
  if (path.startsWith("/send?")) {
    String name = getParameter(path, "name"); name.trim();
    String txt = getParameter(path, "txt"); txt.trim();
    if (name.length() == 0) name = "Family";
    if (name.length() > 16) name = name.substring(0, 16);
    if (txt.length() > 120) txt = txt.substring(0, 120);
    if (txt.length() > 0) {
      int slot;
      if (messageCount < MAX_MESSAGES) slot = messageCount++;
      else {
        for (int i = 1; i < MAX_MESSAGES; i++) {
          messageNames[i - 1] = messageNames[i];
          messageTexts[i - 1] = messageTexts[i];
          messageTimes[i - 1] = messageTimes[i];
        }
        slot = MAX_MESSAGES - 1;
      }
      messageNames[slot] = name;
      messageTexts[slot] = txt;
      messageTimes[slot] = millis();
    }
    sendHeader(client, "text/plain; charset=utf-8"); client.print(F("OK")); client.stop(); return;
  }
  if (path.startsWith("/task?")) {
    int id = getParameter(path, "id").toInt();
    if (id >= 0 && id < taskCount) taskDone[id] = !taskDone[id];
    redirectClient(client, "/#tasks"); return;
  }
  if (path.startsWith("/addtask?")) {
    String item = getParameter(path, "txt"); item.trim();
    if (item.length() > 50) item = item.substring(0, 50);
    if (item.length() && taskCount < 5) { tasks[taskCount] = item; taskDone[taskCount] = false; taskCount++; }
    redirectClient(client, "/#tasks"); return;
  }
  if (path == "/reset") {
    tasks[0] = "Workout"; tasks[1] = "Water"; tasks[2] = "Read"; tasks[3] = ""; tasks[4] = "";
    for (int i = 0; i < 5; i++) taskDone[i] = false;
    taskCount = 3; redirectClient(client, "/#sysinfo"); return;
  }

  sendHeader(client, "text/html; charset=utf-8");
  client.print(F(R"HTML(<!doctype html>
