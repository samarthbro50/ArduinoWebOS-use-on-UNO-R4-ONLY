const codeCanvas=document.getElementById('codeCanvas'),codeCtx=codeCanvas.getContext('2d');
let codeSprite={x:180,y:140,size:32,color:'#a78bfa',visible:true,angle:0},codeRunning=false,codeRunToken=0;
const codeColors={purple:'#a78bfa',red:'#f87171',blue:'#60a5fa',green:'#4ade80',yellow:'#facc15',pink:'#f472b6',orange:'#fb923c',cyan:'#22d3ee',white:'#f8fafc'};
function codeDraw(){if(!codeCtx)return;codeCtx.clearRect(0,0,360,280);codeCtx.fillStyle='#0b1728';codeCtx.fillRect(0,0,360,280);codeCtx.strokeStyle='#ffffff12';for(let x=0;x<=360;x+=20){codeCtx.beginPath();codeCtx.moveTo(x,0);codeCtx.lineTo(x,280);codeCtx.stroke();}for(let y=0;y<=280;y+=20){codeCtx.beginPath();codeCtx.moveTo(0,y);codeCtx.lineTo(360,y);codeCtx.stroke();}if(codeSprite.visible){codeCtx.save();codeCtx.translate(codeSprite.x,codeSprite.y);codeCtx.rotate(codeSprite.angle);let r=codeSprite.size/2;codeCtx.fillStyle=codeSprite.color;codeCtx.beginPath();codeCtx.arc(0,0,r,0,Math.PI*2);codeCtx.fill();codeCtx.fillStyle='#111827';codeCtx.beginPath();codeCtx.arc(-r*.3,-r*.12,Math.max(2,r*.09),0,Math.PI*2);codeCtx.arc(r*.3,-r*.12,Math.max(2,r*.09),0,Math.PI*2);codeCtx.fill();codeCtx.strokeStyle='#111827';codeCtx.lineWidth=2;codeCtx.beginPath();codeCtx.arc(0,r*.05,r*.38,.2,Math.PI-.2);codeCtx.stroke();codeCtx.restore();}}
function codeLog(msg){const out=document.getElementById('codeOutput');if(out)out.textContent+=(out.textContent?'\n':'')+msg; if(out)out.scrollTop=out.scrollHeight;}
function codeWait(ms,token){return new Promise(resolve=>{let start=Date.now();function tick(){if(!codeRunning||token!==codeRunToken)return resolve(false);if(Date.now()-start>=ms)return resolve(true);setTimeout(tick,40);}tick();});}
function codeDuration(raw){let n=Number(String(raw||'1').replace(/\s/g,''));if(!Number.isFinite(n))n=1;return Math.max(0.1,Math.min(30,n))*1000;}
function codeParse(line){let s=line.trim();if(!s||s.startsWith('//')||s.startsWith('#'))return [];let m;
// Accept the user's chained syntax: sprite.move(up,down,left,right)(2secs), doing each direction in order.
 m=s.match(/^sprite\.move\((up|down|left|right)(?:\s*,\s*(up|down|left|right))*\)\s*\(\s*([0-9.]+)\s*sec(?:s|onds?)?\s*\)$/i);
 if(m){let inside=s.match(/^sprite\.move\((.*?)\)/i)[1].split(',').map(x=>x.trim().toLowerCase());return inside.map(d=>({op:'move',dir:d,ms:codeDuration(m[3])}));}
 m=s.match(/^sprite\.move\(\s*(up|down|left|right)\s*(?:,\s*([0-9.]+)\s*sec(?:s|onds?)?)?\s*\)\s*(?:\(\s*([0-9.]+)\s*sec(?:s|onds?)?\s*\))?$/i);if(m)return [{op:'move',dir:m[1].toLowerCase(),ms:codeDuration(m[3]||m[2]||1)}];
 m=s.match(/^sprite\.(hide|show|reset)\s*\(\s*(.*?)\s*\)\s*$/i);if(m){let op=m[1].toLowerCase();if(op==='hide')return [{op:'hide',ms:codeDuration((m[2].match(/[0-9.]+/)||[])[0]||1)}];return [{op}];}
 m=s.match(/^sprite\.(wait|spin)\s*\(\s*([0-9.]+)\s*sec(?:s|onds?)?\s*\)\s*$/i);if(m)return [{op:m[1].toLowerCase(),ms:codeDuration(m[2])}];
 m=s.match(/^sprite\.(say|color|size|jump)\s*\(\s*(.*?)\s*\)\s*$/i);if(m){let op=m[1].toLowerCase(),v=m[2].replace(/^['"]|['"]$/g,'');if(op==='size'){let n=Number(v);if(!Number.isFinite(n))throw Error('size needs a number, e.g. sprite.size(40)');v=Math.max(10,Math.min(80,n));}if(op==='jump'){let n=Number(v);if(!Number.isFinite(n))throw Error('jump needs pixels, e.g. sprite.jump(60)');v=Math.max(10,Math.min(120,n));}return [{op,value:v}];}
 throw Error('Unknown command: '+s+' — open the command guide for examples.');}
async function codeRun(){if(codeRunning)codeStop();codeRunning=true;let token=++codeRunToken;document.getElementById('codeOutput').textContent='Running program…';let lines=document.getElementById('codeProgram').value.split(/\r?\n/);try{for(let i=0;i<lines.length;i++){if(!codeRunning||token!==codeRunToken)break;let commands=codeParse(lines[i]);for(const c of commands){if(!codeRunning||token!==codeRunToken)break;codeLog('> '+lines[i].trim());if(c.op==='move'){let dx=c.dir==='left'?-1:c.dir==='right'?1:0,dy=c.dir==='up'?-1:c.dir==='down'?1:0;let start=Date.now(),x=codeSprite.x,y=codeSprite.y;while(Date.now()-start<c.ms&&codeRunning&&token===codeRunToken){let f=Math.min(1,(Date.now()-start)/c.ms);codeSprite.x=Math.max(codeSprite.size/2,Math.min(360-codeSprite.size/2,x+dx*100*f));codeSprite.y=Math.max(codeSprite.size/2,Math.min(280-codeSprite.size/2,y+dy*100*f));codeDraw();if(!await codeWait(30,token))break;}}
 else if(c.op==='hide'){codeSprite.visible=false;codeDraw();codeLog('Sprite hidden for '+(c.ms/1000)+' second(s).');await codeWait(c.ms,token);codeSprite.visible=true;codeDraw();}
 else if(c.op==='show'){codeSprite.visible=true;codeDraw();}
 else if(c.op==='say'){document.getElementById('codeSpeech').textContent=String(c.value);}
 else if(c.op==='color'){let key=String(c.value).toLowerCase();let color=codeColors[key]||(/^#[0-9a-f]{6}$/i.test(key)?key:null);if(!color)throw Error('Unknown color. Try purple, red, blue, green, yellow, pink, orange, cyan, white or #hexcode.');codeSprite.color=color;codeDraw();}
 else if(c.op==='size'){codeSprite.size=Number(c.value);codeDraw();}
 else if(c.op==='jump'){let oldY=codeSprite.y;codeSprite.y=Math.max(codeSprite.size/2,oldY-Number(c.value));codeDraw();await codeWait(250,token);codeSprite.y=oldY;codeDraw();}
 else if(c.op==='spin'){let start=Date.now(),base=codeSprite.angle;while(Date.now()-start<c.ms&&codeRunning&&token===codeRunToken){codeSprite.angle=base+((Date.now()-start)/c.ms)*Math.PI*4;codeDraw();if(!await codeWait(30,token))break;}codeSprite.angle=base;codeDraw();}
 else if(c.op==='wait'){if(!await codeWait(c.ms,token))break;}
 else if(c.op==='reset'){codeSprite={x:180,y:140,size:32,color:'#a78bfa',visible:true,angle:0};document.getElementById('codeSpeech').textContent='Sprite reset!';codeDraw();}
 }}if(codeRunning&&token===codeRunToken)codeLog('✓ Program finished!');}catch(e){codeLog('⚠ Line '+(lines.findIndex(x=>{try{codeParse(x);return false}catch(err){return err.message===e.message}})+1)+': '+e.message);}finally{if(token===codeRunToken)codeRunning=false;}}
function codeStop(){codeRunning=false;codeRunToken++;codeSprite.visible=true;codeDraw();codeLog('■ Stopped.');}
