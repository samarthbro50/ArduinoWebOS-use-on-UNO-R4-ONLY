const unitOptions={length:[['m','metres',1],['km','kilometres',1000],['cm','centimetres',.01],['mm','millimetres',.001],['mi','miles',1609.344],['ft','feet',.3048]],weight:[['kg','kilograms',1],['g','grams',.001],['mg','milligrams',.000001],['lb','pounds',.45359237],['oz','ounces',.028349523]],temp:[['C','°C'],['F','°F'],['K','Kelvin']]};
function setupUnits(){let kind=document.getElementById('unitKind').value,from=document.getElementById('unitFrom'),to=document.getElementById('unitTo');from.textContent='';to.textContent='';unitOptions[kind].forEach((u,i)=>{let a=new Option(u[1]||u[0],u[0]),b=new Option(u[1]||u[0],u[0]);from.add(a);to.add(b);});if(kind==='length'){from.value='m';to.value='cm';}else if(kind==='weight'){from.value='kg';to.value='g';}else{from.value='C';to.value='F';}convertUnits();}
function convertUnits(){if(!document.getElementById('unitFrom').options.length){setupUnits();return;}let k=document.getElementById('unitKind').value,v=Number(document.getElementById('unitValue').value||0),f=document.getElementById('unitFrom').value,t=document.getElementById('unitTo').value,ans=v;if(k==='temp'){let c=f==='C'?v:f==='F'?(v-32)*5/9:v-273.15;ans=t==='C'?c:t==='F'?c*9/5+32:c+273.15;}else{let list=unitOptions[k],a=list.find(x=>x[0]===f),b=list.find(x=>x[0]===t);ans=v*a[2]/b[2];}document.getElementById('unitResult').textContent=v+' '+f+' = '+Number(ans.toFixed(6))+' '+t;}
