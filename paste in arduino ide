const dodgeCanvas=document.getElementById('dodgeCanvas'),dodgeCtx=dodgeCanvas.getContext('2d');let dodgeTimer=null,dodgeDir=0,dodgePlayer=160,dodgeRocks=[],dodgeScore=0,dodgeLives=3,dodgeFrame=0;
