async function arenaShoot(){if(arenaOver||Date.now()-arenaShotAt<arenaGuns[arenaPlayer.gun].rate)return;arenaShotAt=Date.now();let g=arenaGuns[arenaPlayer.gun];let targets=arenaMode==='solo'?arenaBots.filter(b=>b.hp>0):arenaOthers.filter(p=>p.id!==arenaId&&p.hp>0);if(targets.length){targets.sort((a,b)=>Math.hypot(a.x-arenaPlayer.x,a.y-arenaPlayer.y)-Math.hypot(b.x-arenaPlayer.x,b.y-arenaPlayer.y));let t=targets[0],dist=Math.hypot(t.x-arenaPlayer.x,t.y-arenaPlayer.y);if(dist<g.speed*48+45){if(arenaMode==='solo'){t.hp-=g.damage;if(t.hp<=0){arenaPlayer.points+=100;arenaPlayer.cash+=100;document.getElementById('arenaStatus').textContent='Enemy eliminated! +100 points and +100 cash.';arenaBots=arenaBots.filter(b=>b.hp>0);if(arenaBots.length<3&&!arenaOver)arenaBots.push({x:80+Math.random()*560,y:40+Math.random()*300,hp:60,cd:0});}arenaHud();}else if(arenaId>=0){try{let r=await fetch('/arena?act=hit&id='+arenaId+'&target='+t.id+'&dmg='+g.damage,{cache:'no-store'});let d=await r.json();if(d.hit){document.getElementById('arenaStatus').textContent=d.eliminated?'Opponent eliminated! +100 points and cash.':'Hit '+t.name+'!';if(d.eliminated){arenaPlayer.points+=100;arenaPlayer.cash+=100;arenaHud();}}}catch(e){document.getElementById('arenaStatus').textContent='Could not send shot to LAN server.';}}}}arenaBullets.push({x:arenaPlayer.x,y:arenaPlayer.y,life:10});}
function arenaStep(){if(arenaOver)return;arenaFrame++;let speed=3.2;arenaPlayer.x=Math.max(14,Math.min(706,arenaPlayer.x+arenaDir.x*speed));arenaPlayer.y=Math.max(14,Math.min(386,arenaPlayer.y+arenaDir.y*speed));if(arenaMode==='solo'){arenaBots.forEach(b=>{if(b.hp<=0)return;let d=Math.hypot(arenaPlayer.x-b.x,arenaPlayer.y-b.y)||1;b.x+=(arenaPlayer.x-b.x)/d*(d>90?0.8:0.2);b.y+=(arenaPlayer.y-b.y)/d*(d>90?0.8:0.2);if(d<23&&arenaFrame%22===0){arenaPlayer.hp=Math.max(0,arenaPlayer.hp-5);arenaHud();}});if(arenaPlayer.hp<=0){arenaOver=true;document.getElementById('arenaStatus').textContent='You were eliminated! Points: '+arenaPlayer.points+'. Press Start / Restart.';saveGameScore('Battle Arena',arenaPlayer.points);}}arenaBullets.forEach(b=>b.life--);arenaBullets=arenaBullets.filter(b=>b.life>0);if(arenaMode==='multi'&&arenaId>=0&&Date.now()-arenaLastSync>1000)arenaSync();arenaHud();arenaDraw();}
function arenaDraw(){let c=arenaCtx;c.fillStyle='#1f3a2a';c.fillRect(0,0,720,400);c.strokeStyle='#ffffff0d';for(let x=0;x<720;x+=40){c.beginPath();c.moveTo(x,0);c.lineTo(x,400);c.stroke();}for(let y=0;y<400;y+=40){c.beginPath();c.moveTo(0,y);c.lineTo(720,y);c.stroke();}for(let i=0;i<16;i++){let x=(i*131+60)%690,y=(i*79+40)%370;c.fillStyle=i%2?'#36543a':'#4b5563';c.fillRect(x,y,18,18);}arenaBots.forEach(b=>{if(b.hp<=0)return;c.fillStyle='#ef4444';c.beginPath();c.arc(b.x,b.y,11,0,Math.PI*2);c.fill();c.fillStyle='#111827';c.fillRect(b.x-12,b.y-18,24,3);c.fillStyle='#22c55e';c.fillRect(b.x-12,b.y-18,24*Math.max(0,b.hp)/60,3);});if(arenaMode==='multi')arenaOthers.forEach(p=>{if(p.id===arenaId)return;c.fillStyle='#f97316';c.beginPath();c.arc(p.x,p.y,11,0,Math.PI*2);c.fill();c.fillStyle='white';c.font='11px Arial';c.textAlign='center';c.fillText(p.name||'Player',p.x,p.y-16);});arenaBullets.forEach(b=>{c.fillStyle='#fde047';c.beginPath();c.arc(b.x,b.y,3,0,Math.PI*2);c.fill();});c.fillStyle='#38bdf8';c.beginPath();c.arc(arenaPlayer.x,arenaPlayer.y,12,0,Math.PI*2);c.fill();c.fillStyle='#e0f2fe';c.fillRect(arenaPlayer.x-4,arenaPlayer.y-3,8,6);c.fillStyle='white';c.font='12px Arial';c.textAlign='left';c.fillText(arenaGuns[arenaPlayer.gun].name,10,18);if(arenaMode==='multi')c.fillText('LAN MULTIPLAYER',520,18);else c.fillText('SOLO SURVIVAL',570,18);}
document.getElementById('arenaCanvas').addEventListener('pointerdown',e=>{const r=arenaCanvas.getBoundingClientRect();arenaDir.x=(e.clientX-r.left<r.width/2)?-1:1;arenaShoot();});
