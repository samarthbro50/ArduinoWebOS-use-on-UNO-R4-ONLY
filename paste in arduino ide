function stepSnake(){dir=nextDir;let h={x:snake[0].x+dir.x,y:snake[0].y+dir.y};let eat=h.x===food.x&&h.y===food.y,bonus=bonusFood&&h.x===bonusFood.x&&h.y===bonusFood.y;if(h.x<0||h.y<0||h.x>=20||h.y>=20||snakeWalls.some(p=>p.x===h.x&&p.y===h.y)||snake.slice(0,(eat||bonus)?snake.length:snake.length-1).some(p=>p.x===h.x&&p.y===h.y)){clearInterval(snakeTimer);snakeTimer=null;document.getElementById('sm').textContent='Game over! Final score: '+score+'. Press Restart.';saveGameScore('Snake',score);return;}snake.unshift(h);if(eat||bonus){score+=bonus?3:1;document.getElementById('ss').textContent=score;document.getElementById('snakeBest').textContent=Math.max(score,Number(localStorage.getItem('arduinoos_snake_best')||0));try{localStorage.setItem('arduinoos_snake_best',String(Math.max(score,Number(localStorage.getItem('arduinoos_snake_best')||0))))}catch(e){}if(eat){food=snakeFreeCell();if(score>0&&score%4===0&&!bonusFood)bonusFood=snakeFreeCell();}if(bonus)bonusFood=null;}else snake.pop();drawSnake();}
