let arenaTimer=null,arenaPoll=null,arenaId=-1,arenaDir={x:0,y:0},arenaPlayer={x:80,y:80,hp:100,cash:300,points:0,gun:0},arenaBots=[],arenaBullets=[],arenaOthers=[],arenaLastSync=0,arenaShotAt=0,arenaFrame=0,arenaMode='solo',arenaOver=false;
const arenaGuns=[{name:'Pistol',cost:0,damage:20,rate:450,speed:7},{name:'SMG',cost:150,damage:12,rate:130,speed:8},{name:'Rifle',cost:300,damage:28,rate:280,speed:10},{name:'Shotgun',cost:250,damage:14,rate:650,speed:7},{name:'Sniper',cost:400,damage:60,rate:1000,speed:13}];
function arenaStart(restart){if(restart){arenaStop();arenaId=-1;arenaPlayer={x:80,y:80,hp:100,cash:300,points:0,gun:0};}if(arenaTimer)clearInterval(arenaTimer);arenaMode=document.getElementById('arenaMode').value;arenaOver=false;arenaBullets=[];arenaBots=[];arenaOthers=[];arenaFrame=0;for(let i=0;i<(arenaMode==='solo'?6:0);i++)arenaBots.push({x:100+Math.random()*520,y:50+Math.random()*300,hp:60,cd:0});document.getElementById('arenaStatus').textContent=arenaMode==='solo'?'Solo match: defeat bots to earn points and cash.':'Joining ArduinoOS LAN arena…';if(arenaMode==='multi'){arenaJoin();}else{arenaPlayer.x=80;arenaPlayer.y=80;}arenaTimer=setInterval(arenaStep,40);arenaDraw();}
function arenaStop(){if(arenaTimer)clearInterval(arenaTimer);if(arenaPoll)clearInterval(arenaPoll);arenaTimer=arenaPoll=null;if(arenaId>=0){fetch('/arena?act=leave&id='+arenaId,{cache:'no-store'}).catch(()=>{});arenaId=-1;}}
async function arenaJoin(){try{let old=-1;try{old=Number(localStorage.getItem('arduinoos_arena_id')||-1);}catch(e){}let name=encodeURIComponent(document.getElementById('arenaName').value||'Player');let r=await fetch('/arena?act=join&id='+old+'&name='+name,{cache:'no-store'});let d=await r.json();if(!d.ok){document.getElementById('arenaStatus').textContent='Arena is full (4 players max). Try again after someone leaves.';return;}arenaId=d.id;try{localStorage.setItem('arduinoos_arena_id',String(arenaId));}catch(e){}arenaPlayer.x=arenaId%2?650:70;arenaPlayer.y=arenaId<2?70:300;document.getElementById('arenaStatus').textContent='LAN multiplayer connected as Player '+(arenaId+1)+'. Other players must join the same ArduinoOS Wi-Fi.';if(arenaPoll)clearInterval(arenaPoll);arenaPoll=setInterval(arenaSync,350);}catch(e){document.getElementById('arenaStatus').textContent='Could not join LAN mode. Make sure you opened ArduinoOS at http://192.168.4.1.';}}
